# Environment variables for local development
# Copy this file to .env.local and fill in your values

# OpenAI API Key for blog generation
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Specify GPT model (default: gpt-4-turbo-preview)
# OPENAI_MODEL=gpt-4-turbo-preview

# ─── Labs Platform ───
# GitHub token for triggering lab provisioning workflows
# Create a PAT with 'repo' and 'actions' scopes at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_REPO=DevOps-Duoo/Devopsduoo_Site
